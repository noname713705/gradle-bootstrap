Subject: [PATCH 2/3] build.gradle: adapt to the gradle-0.1.4 builder

addMavenRepo(), zip(baseName) instead of zip(classifier:), childrenDependOn,
:jar instead of @jar

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 build.gradle | 24 ++++++++++++------------
 1 file changed, 12 insertions(+), 12 deletions(-)

diff --git a/build.gradle b/build.gradle
index 53065da6464..e78bded2534 100644
--- a/build.gradle
+++ b/build.gradle
@@ -63,13 +63,13 @@ dependencies {
 
     clientModule(['ftpAntTask'], "org.apache.ant:ant-commons-net:1.7.0") {
         clientModule("commons-net:commons-net:1.4.1") {
-            dependencies("oro:oro:2.0.8@jar")
+            dependencies("oro:oro:2.0.8:jar")
         }
     }
     clientModule(['groovy'], "org.codehaus.groovy:groovy-all:1.5.5") {
         dependency("commons-cli:commons-cli:1.0")
         clientModule("org.apache.ant:ant:1.7.0") {
-            dependencies("org.apache.ant:ant-junit:1.7.0@jar", "org.apache.ant:ant-launcher:1.7.0")
+            dependencies("org.apache.ant:ant-junit:1.7.0:jar", "org.apache.ant:ant-launcher:1.7.0")
         }
     }
     
@@ -83,18 +83,18 @@ dependencies {
     compile "ch.qos.logback:logback-classic:0.9.8",
             "org.slf4j:slf4j-api:1.4.3",
             "ch.qos.logback:logback-core:0.9.8",
-            "commons-io:commons-io:1.3.1@jar",
-            "commons-lang:commons-lang:2.3@jar",
+            "commons-io:commons-io:1.3.1:jar",
+            "commons-lang:commons-lang:2.3:jar",
             "slide:webdavlib:2.0",
             "ch.qos.logback:logback-classic:0.9.8",
-            "org.apache.ivy:ivy:2.0.0@jar"
+            "org.apache.ivy:ivy:2.0.0:jar"
     runtime "org.apache.ant:ant-launcher:1.7.0",
             "org.apache.ant:ant-nodeps:1.7.0",
             "junit:junit:4.4"
 
     testCompile "junit:junit:4.4"
     distLib "junit:junit:4.4"
-    addIBiblio()
+    addMavenRepo()
     addFlatDirResolver('lib', new File(rootDir, 'lib'))
 }
 
@@ -139,7 +139,7 @@ createTask('explodedDist', dependsOn: 'libs') {
         logger.info('Generate start scripts')
         StartScriptsGenerator.generate("$archivesBaseName-${version}.jar", explodedDistBinDir, archivesBaseName)
         logger.info('Generate and copy samples.')
-        WrapperProjectCreator.createProject(explodedDistSamplesDir, task('gradle_bin_zip').archivePath.parentFile,
+        WrapperProjectCreator.createProject(explodedDistSamplesDir, task('gradle-bin_zip').archivePath.parentFile,
                 version.toString())
         copy(toDir: explodedDistSamplesDir) {fileset(dir: new File(srcRoot, 'samples'))}
         logger.info('Copy binary sources.')
@@ -160,8 +160,8 @@ zipRootFolder = "$archivesBaseName-${-> version}"
 
 dists {
     dependsOn 'explodedDist', 'userguide', 'javadoc'
-    childrenDependsOn = 'explodedDist'
-    zip(classifier: 'all').afterDag {
+    childrenDependOn << 'explodedDist'
+    zip("$archivesBaseName-all").afterDag {
         zipFileSet(dir: explodedDistDir, prefix: zipRootFolder) {
             exclude 'bin/*'
         }
@@ -173,7 +173,7 @@ dists {
             include 'bin/*.*'
         }
     }
-    zip(classifier: 'bin').afterDag {
+    zip("$archivesBaseName-bin").afterDag {
         zipFileSet(dir: explodedDistDir, prefix: zipRootFolder) {
             exclude 'bin/*'
             exclude 'src/'
@@ -187,7 +187,7 @@ dists {
             include 'bin/*.*'
         }
     }
-    zip(classifier: 'src').afterDag {
+    zip("$archivesBaseName-src").afterDag {
         destinationDir = distsDir
         zipFileSet(dir: projectDir, prefix: archiveName, fileMode: '775') {
             include 'gradlew'
@@ -298,7 +298,7 @@ createTask('install', dependsOn: 'integTest') {
             arg(value: '-q')
             arg(value: '-d')
             arg(value: installDir)
-            arg(value: "${task('gradle_all_zip').archivePath}")
+            arg(value: "${task('gradle-all_zip').archivePath}")
         }
         exec(dir: installDir, executable: "mv") {
             arg(value: zipRootFolder)
