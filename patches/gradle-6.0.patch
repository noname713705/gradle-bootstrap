From 04b67fc2b79a2a3a9fafb8e95b0c7f45dd9ddb11 Mon Sep 17 00:00:00 2001
From: noname713705 <noname713705@gmail.com>
Date: Wed, 14 Oct 2026 23:45:38 +0200
Subject: [PATCH] Rebuild Gradle 6.0 from its original build files (download
 fixes only)

Built by a minimal bootstrap of 6.0 (scripts/GradleMinimalBootstrap60.java,
compiled without Gradle, Kotlin DSL compiled with kotlinc). Fixes, all marked
"bootstrap:":
- Maven Central first (repo.gradle.org/gradle/libs does not mirror it anymore)
- bintray repositories removed (gone, requests hang until they time out)
- repo.gradle.org libs-releases with metadataSources { mavenPom(); artifact() }:
  pmaven-common and pmaven-groovy 0.8-20100325 are there without their pom
- ktlint tasks disabled in buildSrc (kolor 0.0.2 was on jcenter only)
- http-builder 0.7.2 (on no repository anymore) -> 0.7.1
- org.samba.jcifs:jcifs -> jcifs:jcifs (same version)

Run (JDK 11): clean install -Pgradle_installPath=build/distributions/rebuilt-minimal

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 build.gradle.kts                              | 21 ++++++++++++-------
 buildSrc/build.gradle.kts                     | 19 ++++++++++-------
 .../performance/performance.gradle.kts        |  3 ++-
 gradle/dependencies.gradle                    |  3 ++-
 4 files changed, 28 insertions(+), 18 deletions(-)

diff --git a/build.gradle.kts b/build.gradle.kts
index 7fa6d42bdac..741aa6fe525 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -154,18 +154,23 @@ allprojects {
     group = "org.gradle"
 
     repositories {
+        // bootstrap: repo.gradle.org/gradle/libs does not mirror Maven Central anymore: Maven Central first
+        mavenCentral()
+        // bootstrap: some modules on repo.gradle.org lost their pom (pmaven 0.8-20100325): jar without metadata allowed
+        // (Gradle 6 needs a pom or module metadata by default)
         maven {
-            name = "Gradle libs"
-            url = uri("https://repo.gradle.org/gradle/libs")
-        }
-        maven {
-            name = "kotlinx"
-            url = uri("https://kotlin.bintray.com/kotlinx/")
+            url = uri("https://repo.gradle.org/gradle/libs-releases")
+            metadataSources {
+                mavenPom()
+                artifact()
+            }
         }
         maven {
-            name = "kotlin-eap"
-            url = uri("https://dl.bintray.com/kotlin/kotlin-eap")
+            name = "Gradle libs"
+            url = uri("https://repo.gradle.org/gradle/libs")
         }
+        // bootstrap: bintray is gone (requests hang until they time out): kotlinx https://kotlin.bintray.com/kotlinx/ removed
+        // bootstrap: bintray is gone (requests hang until they time out): kotlin-eap https://dl.bintray.com/kotlin/kotlin-eap removed
     }
 
     // patchExternalModules lives in the root project - we need to activate normalization there, too.
diff --git a/buildSrc/build.gradle.kts b/buildSrc/build.gradle.kts
index 3965270c9ad..ca6d3c7eec0 100644
--- a/buildSrc/build.gradle.kts
+++ b/buildSrc/build.gradle.kts
@@ -73,6 +73,8 @@ subprojects {
 
 allprojects {
     repositories {
+        // bootstrap: repo.gradle.org/gradle/libs does not mirror Maven Central anymore: Maven Central first
+        mavenCentral()
         maven {
             name = "Gradle libs"
             url = uri("https://repo.gradle.org/gradle/libs")
@@ -82,14 +84,8 @@ allprojects {
             name = "Gradle snapshot libs"
             url = uri("https://repo.gradle.org/gradle/libs-snapshots")
         }
-        maven {
-            name = "kotlinx"
-            url = uri("https://dl.bintray.com/kotlin/kotlinx")
-        }
-        maven {
-            name = "kotlin-eap"
-            url = uri("https://dl.bintray.com/kotlin/kotlin-eap")
-        }
+        // bootstrap: bintray is gone (requests hang until they time out): kotlinx https://dl.bintray.com/kotlin/kotlinx removed
+        // bootstrap: bintray is gone (requests hang until they time out): kotlin-eap https://dl.bintray.com/kotlin/kotlin-eap removed
     }
 }
 
@@ -240,3 +236,10 @@ fun Project.applyKotlinProjectConventions() {
     }
 }
 
+
+// bootstrap: the ktlint tasks are disabled (their kolor 0.0.2 dependency was on bintray/jcenter only)
+allprojects {
+    tasks.matching { it.name.startsWith("ktlint") }.configureEach {
+        enabled = false
+    }
+}
diff --git a/buildSrc/subprojects/performance/performance.gradle.kts b/buildSrc/subprojects/performance/performance.gradle.kts
index b960bd9edf7..c7cce9903d8 100644
--- a/buildSrc/subprojects/performance/performance.gradle.kts
+++ b/buildSrc/subprojects/performance/performance.gradle.kts
@@ -1,7 +1,8 @@
 dependencies {
     api(project(":integrationTesting"))
     implementation(project(":build"))
-    implementation("org.codehaus.groovy.modules.http-builder:http-builder:0.7.2")
+    // bootstrap: http-builder 0.7.2 is on no repository anymore, no newer version exists: 0.7.1 (Maven Central)
+    implementation("org.codehaus.groovy.modules.http-builder:http-builder:0.7.1")
     implementation("org.openmbee.junit:junit-xml-parser:1.0.0") {
         // don't need it at runtime
         exclude(module = "lombok")
diff --git a/gradle/dependencies.gradle b/gradle/dependencies.gradle
index 9415e6f9837..98cc8347ed8 100755
--- a/gradle/dependencies.gradle
+++ b/gradle/dependencies.gradle
@@ -65,7 +65,8 @@ libraries.jackson_databind =    [coordinates: 'com.fasterxml.jackson.core:jackso
 libraries.jansi =               [coordinates: 'org.fusesource.jansi:jansi', version: '1.18', license: "Apache 2.0"]
 libraries.jatl =                [coordinates: 'com.googlecode.jatl:jatl', version: '0.2.3', license: "Apache 2.0"]
 libraries.jaxb =                [coordinates: 'com.sun.xml.bind:jaxb-impl', version: '2.3.2', license: "CDDL"]
-libraries.jcifs =               [coordinates: 'org.samba.jcifs:jcifs', version: '1.3.17', license: "LGPL 2.1"]
+// bootstrap: org.samba.jcifs:jcifs:1.3.17 is not on Maven Central anymore: jcifs:jcifs, same version
+libraries.jcifs =               [coordinates: 'jcifs:jcifs', version: '1.3.17', license: "LGPL 2.1"]
 libraries.jgit =                [coordinates: 'org.eclipse.jgit:org.eclipse.jgit', version: '5.5.0.201909110433-r', license: "Eclipse Distribution License 1.0"]
 libraries.joda =                [coordinates: 'joda-time:joda-time', version: '2.10.4', license: "Apache 2.0"]
 libraries.jsch =                [coordinates: 'com.jcraft:jsch', version: '0.1.55', license: 'BSD-style']
