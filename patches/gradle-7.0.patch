From b9ec9df33a569181a0c43c3d4a8553e4fa3a09a8 Mon Sep 17 00:00:00 2001
From: noname713705 <noname713705@gmail.com>
Date: Thu, 15 Oct 2026 02:14:14 +0200
Subject: [PATCH] Rebuild Gradle 7.0 from its original build files (bootstrap
 fixes)

Built by a minimal bootstrap of 7.0 (scripts/GradleMinimalBootstrap70.java,
compiled without Gradle). Changes, all marked "bootstrap:":
- bintray repositories removed (gone, requests hang until they time out)
- Maven Central first (repo.gradle.org/gradle/libs does not mirror it anymore)
- repo.gradle.org libs-releases with metadataSources { mavenPom(); artifact() }:
  pmaven-common and pmaven-groovy 0.8-20100325 are there without their pom
- http-builder 0.7.2 (on no repository anymore) -> 0.7.1
- org.samba.jcifs:jcifs -> jcifs:jcifs (same version)
- JDK 11 toolchain without the ADOPTOPENJDK vendor (AdoptOpenJDK builds are
  gone, Temurin reports "Eclipse Adoptium")

Run (JDK 11): IGNORE_MIRROR=true gradle --dependency-verification lenient
  -Porg.gradle.java.installations.auto-download=false
  install -Pgradle_installPath=build/distributions/rebuilt-minimal

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../gradlebuild.repositories.gradle.kts       | 25 ++++++++++---------
 build-logic/build-platform/build.gradle.kts   |  3 ++-
 .../extension/ExternalModulesExtension.kt     |  3 ++-
 ...radlebuild.unittest-and-compile.gradle.kts |  4 ++-
 build-logic/settings.gradle.kts               | 22 +++++-----------
 5 files changed, 26 insertions(+), 31 deletions(-)

diff --git a/build-logic/basics/src/main/kotlin/gradlebuild.repositories.gradle.kts b/build-logic/basics/src/main/kotlin/gradlebuild.repositories.gradle.kts
index 44643d1839b..fd19197e097 100644
--- a/build-logic/basics/src/main/kotlin/gradlebuild.repositories.gradle.kts
+++ b/build-logic/basics/src/main/kotlin/gradlebuild.repositories.gradle.kts
@@ -15,20 +15,21 @@
  */
 
 repositories {
+    // bootstrap: repo.gradle.org/gradle/libs does not mirror Maven Central anymore: Maven Central first
+    mavenCentral()
+    // bootstrap: some modules on repo.gradle.org lost their pom (pmaven 0.8-20100325): jar without metadata allowed
     maven {
-        name = "Gradle libs"
-        url = uri("https://repo.gradle.org/gradle/libs")
-    }
-    maven {
-        name = "kotlinx"
-        url = uri("https://kotlin.bintray.com/kotlinx/")
+        url = uri("https://repo.gradle.org/gradle/libs-releases")
+        metadataSources {
+            mavenPom()
+            artifact()
+        }
     }
     maven {
-        name = "kotlin-dev"
-        url = uri("https://dl.bintray.com/kotlin/kotlin-dev")
-    }
-    maven {
-        name = "kotlin-eap"
-        url = uri("https://dl.bintray.com/kotlin/kotlin-eap")
+        name = "Gradle libs"
+        url = uri("https://repo.gradle.org/gradle/libs")
     }
+    // bootstrap: bintray is gone (requests hang until they time out): kotlinx https://kotlin.bintray.com/kotlinx/ removed
+    // bootstrap: bintray is gone (requests hang until they time out): kotlin-dev https://dl.bintray.com/kotlin/kotlin-dev removed
+    // bootstrap: bintray is gone (requests hang until they time out): kotlin-eap https://dl.bintray.com/kotlin/kotlin-eap removed
 }
diff --git a/build-logic/build-platform/build.gradle.kts b/build-logic/build-platform/build.gradle.kts
index 3d9a1db76d8..70a789d26a0 100644
