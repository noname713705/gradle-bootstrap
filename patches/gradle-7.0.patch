-        maven {
-            name = "kotlinx"
-            url = uri("https://dl.bintray.com/kotlin/kotlinx")
-        }
-        maven {
-            name = "kotlin-dev"
-            url = uri("https://dl.bintray.com/kotlin/kotlin-dev")
-        }
-        maven {
-            name = "kotlin-eap"
-            url = uri("https://dl.bintray.com/kotlin/kotlin-eap")
-        }
+        // bootstrap: bintray is gone (requests hang until they time out): kotlinx https://dl.bintray.com/kotlin/kotlinx removed
+        // bootstrap: bintray is gone (requests hang until they time out): kotlin-dev https://dl.bintray.com/kotlin/kotlin-dev removed
+        // bootstrap: bintray is gone (requests hang until they time out): kotlin-eap https://dl.bintray.com/kotlin/kotlin-eap removed
         maven {
             name = "ge-release-candidates"
             url = uri("https://repo.gradle.org/gradle/enterprise-libs-release-candidates-local")
