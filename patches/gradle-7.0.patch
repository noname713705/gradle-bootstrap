+++ b/build-logic/jvm/src/main/kotlin/gradlebuild.unittest-and-compile.gradle.kts
@@ -47,7 +47,9 @@ tasks.registerCITestDistributionLifecycleTasks()
 fun configureCompile() {
     java.toolchain {
         languageVersion.set(JavaLanguageVersion.of(11))
-        vendor.set(JvmVendorSpec.ADOPTOPENJDK)
+        // bootstrap: any JDK 11 (AdoptOpenJDK builds are gone, Temurin reports "Eclipse Adoptium", which Gradle 7.0
+        // does not match with ADOPTOPENJDK; provisioning one hung in Gradle 7.0's tar extraction)
+        // vendor.set(JvmVendorSpec.ADOPTOPENJDK)
     }
 
     tasks.withType<JavaCompile>().configureEach {
