diff --git a/build.gradle.0.6 b/build.gradle.0.6
new file mode 100644
index 00000000000..ae3b8455bf9
--- /dev/null
+++ b/build.gradle.0.6
@@ -0,0 +1,202 @@
+// build.gradle of REL-0.8 in the DSL of Gradle 0.6 (the builder of this step), see settings.gradle.0.6
+import java.text.SimpleDateFormat
+import java.util.jar.Attributes
+import org.apache.tools.ant.taskdefs.condition.Os
+import org.gradle.api.Task
+import org.gradle.api.artifacts.repositories.WebdavResolver
+import org.gradle.api.tasks.testing.ForkMode
+import org.gradle.api.tasks.wrapper.Wrapper
+import org.gradle.build.release.Svn
+import org.gradle.build.release.Version
+import org.gradle.build.samples.WrapperProjectCreator
+import org.gradle.build.startscripts.StartScriptsGenerator
+import org.apache.ivy.plugins.resolver.*
+
+/**
+ * For building Gradle you usually don't need to specify any properties. Only certain functionality of the Gradle requires
+ * setting certain properties. Those properties can be set in the gradle.properties file in the the gradle user home. The
+ * following properties can be set:
+ *
+ * Uploading distributions to Gradle's release and snapshot repository at codehaus: codehausUserName, codehausUserPassword
+ * Uploading the userguide and the javadoc to Gradle's website: websiteFtpUserName, websiteFtpUserPassword
+ * Using the build to create a new distribution and install it on the local machine: gradle_installPath
+ * Creating a JDK-1.4 compatible distribution with retro-translator: gradle_retroLibsDir (This dir should contain rt.jar, jce.jar and jsse.jar from
+ * a JDK 1.4).
+ */
+
+defaultTasks "clean", "dists"
+
+usePlugin BasePlugin
+
+svn = new Svn(project)
+
+type = 'jar'
+
+buildTime = new Date()
+versionModifier = null
+
+explodedDistDir = new File(distsDir, 'exploded')
+explodedDistDocsDir = new File(explodedDistDir, 'docs')
+explodedDistJavadocsDir = new File(explodedDistDocsDir, 'javadoc')
+explodedDistGroovydocsDir = new File(explodedDistDocsDir, 'groovydoc')
+explodedDistSamplesDir = new File(explodedDistDir, 'samples')
+explodedDistLibDir = new File(explodedDistDir, 'lib')
+samplesSrcDir = file('src/samples')
+userguideOutputDir = new File(samplesSrcDir, 'userguideOutput')
+
+archivesBaseName = 'gradle'
+
+libraries = [
+        ant             : 'org.apache.ant:ant:1.7.0@jar',
+        ant_junit       : 'org.apache.ant:ant-junit:1.7.0@jar',
+        ant_launcher    : 'org.apache.ant:ant-launcher:1.7.0@jar',
+        antlr           : 'antlr:antlr:2.7.7@jar',
+        asm_all         : 'asm:asm-all:2.2.3@jar',
+        commons_cli     : 'commons-cli:commons-cli:1.2@jar',
+        commons_io      : 'commons-io:commons-io:1.4@jar',
+        dom4j           : 'dom4j:dom4j:1.6.1@jar',
+        groovy          : 'org.codehaus.groovy:groovy:1.6.4@jar',
+        jaxen           : 'jaxen:jaxen:1.1@jar',
+        jopt_simple     : 'net.sf.jopt-simple:jopt-simple:2.4.1@jar',
+        jul_to_slf4j    : 'org.slf4j:jul-to-slf4j:1.5.3@jar',
+        logback_classic : 'ch.qos.logback:logback-classic:0.9.9@jar',
+        logback_core    : 'ch.qos.logback:logback-core:0.9.9@jar',
+        slf4j_api       : 'org.slf4j:slf4j-api:1.5.3@jar',
+    ]
+
+libraries.groovy_depends  = [libraries.groovy, libraries.ant, libraries.ant_launcher, libraries.asm_all,
+        libraries.antlr, libraries.commons_cli, libraries.ant_junit]
+
+allprojects {
+    group = 'org.gradle'
+
+    repositories {
+        mavenCentral()
+        add(new URLResolver()) {
+            name = 'sf_gradleRepo'
+            addArtifactPattern('https://gradle.sourceforge.net/gradleRepo/[organisation]/[module](/[branch])/[type]s/[artifact]-[revision](-[classifier])(.[ext])')
+        }
+    }
+
+    // gradle-0.6 builder: subprojects do not inherit the properties of the root project (versionModifier,
+    // previousMajor...) used by Version.toString(): the subprojects share the version of the root project
+    version = project == rootProject ? new Version(svn, project, false) : rootProject.version
+}
+
+def FIRST_LEVEL_JMOCK = ['org.hamcrest:hamcrest-core:1.1@jar', 'org.hamcrest:hamcrest-library:1.1@jar', 'org.jmock:jmock-junit4:2.4.0@jar']
+subprojects {
+
+    usePlugin 'groovy'
+    // gradle-0.6 builder: no plugins.withType(JavaPlugin).whenPluginAdded {} (was in allprojects)
+    sourceCompatibility = 1.5
+    targetCompatibility = 1.5
+    // code-quality (checkstyle, codenarc) not used for the bootstrap
+
+    archivesBaseName = "gradle-${name.replaceAll("\\p{Upper}") { "-${it.toLowerCase()}" } }"
+    dependencies {
+        testCompile "junit:junit:4.5", FIRST_LEVEL_JMOCK
+        testCompile module("org.jmock:jmock:2.4.0") {
+            dependencies('org.jmock:jmock-legacy:2.4.0@jar', 'org.objenesis:objenesis:1.0', 'cglib:cglib-nodep:2.1_3')
+            dependencies(FIRST_LEVEL_JMOCK as Object[])
+        }
+        // todo - these should not be here
+        testCompile 'org.jmock:jmock-legacy:2.4.0@jar', 'org.objenesis:objenesis:1.0', 'cglib:cglib-nodep:2.1_3'
+    }
+
+}
+
+// task ide (IDE classpath helper) left out
+
+configurations {
+    dists
+    distLib {
+        visible = false
+    }
+    ftpAntTask
+    retrotranslatorAntTask
+    userGuideStyleSheets
+    userGuideTask
+}
+
+dependencies {
+    distLib project(':wrapper'), project(':core'), project(':ui'), project(':openApi')
+
+    // todo: Improve dependency handling for xUnit jars
+    ftpAntTask module("org.apache.ant:ant-commons-net:1.7.0") {
+        module("commons-net:commons-net:1.4.1") {
+            dependencies("oro:oro:2.0.8@jar")
+        }
+    }
+
+    retrotranslatorAntTask 'net.sf.retrotranslator:retrotranslator-runtime:1.2.7@jar', 'net.sf.retrotranslator:retrotranslator-transformer:1.2.7@jar',
+            'backport-util-concurrent:backport-util-concurrent:3.1@jar'
+
+    userGuideTask 'xalan:xalan:2.7.1', 'xerces:xercesImpl:2.9.1'
+    userGuideTask module('xhtmlrenderer:xhtmlrenderer:R8rc1') {
+        dependency 'itext:itext:2.0.8@jar'
+    }
+    userGuideTask 'xslthl:xslthl:2.0.1@jar'
+
+    userGuideStyleSheets 'docbook:docbook-xsl:1.75.2@zip'
+}
+
+clean.dependsOn subprojects*.clean
+
+// tasks check and test (aggregates over the subprojects) left out: no check task in gradle-0.6, tests not run
+
+distributionUploadUrl = null
+docsRemoteDir = ''
+javadocRemoteDir = ''
+groovydocRemoteDir = ''
+// gradle-0.6 builder: build.taskGraph (gradle.taskGraph from 0.8)
+build.taskGraph.whenReady {graph ->
+    String prefix = ''
+    if (graph.hasTask(':release')) {
+        versionModifier = ''
+        distributionUploadUrl = 'https://dav.codehaus.org/dist/gradle'
+        prefix = version as String
+    } else {
+        versionModifier = new SimpleDateFormat('yyyyMMddHHmmssZ').format(buildTime)
+        distributionUploadUrl = 'https://dav.codehaus.org/snapshots.dist/gradle'
+        prefix = 'latest'
+    }
+    docsRemoteDir = prefix + '/docs'
+    javadocRemoteDir = docsRemoteDir + '/javadoc'
+    groovydocRemoteDir = docsRemoteDir + '/groovydoc'
+    subprojects {
+      jar.manifest.mainAttributes([
+              (Attributes.Name.IMPLEMENTATION_TITLE.toString()): 'Gradle',
+              (Attributes.Name.IMPLEMENTATION_VERSION.toString()): version.toString(),
+      ])
+    }
+}
+
+// gradle-0.6 builder: a configuration is not a task dependency, its buildDependencies are (the project jars)
+task explodedDistBase(dependsOn: [configurations.distLib.buildDependencies], description: 'Builds a minimal distribution image') << {
+    File explodedDistBinDir = new File(explodedDistDir, 'bin')
+    [explodedDistDir, explodedDistLibDir, explodedDistBinDir]*.mkdirs()
+
+    logger.info('Generate lib dir')
+    removeAnyExistingOldGradleLibs()
+    // gradle-0.6 builder: no project.copy {}; the project jars resolved through distLib lose their version
+    // (internal repository of gradle-0.6): taken from the jar tasks, only the external jars from distLib
+    configurations.distLib.each {File file ->
+        if (!file.name.startsWith("$archivesBaseName-")) { ant.copy(file: file, todir: explodedDistLibDir) }
+    }
+    subprojects.each {p -> ant.copy(file: p.jar.archivePath, todir: explodedDistLibDir) }
+    logger.info('Generate start scripts')
+    StartScriptsGenerator.generate(project(':core').jar.archiveName, explodedDistBinDir, archivesBaseName)
+    logger.info('Copy and generate top level files.')
+    ant.copy(todir: explodedDistDir) { fileset(dir: 'src/toplevel') }
+    // Set permissions (important for running integration tests against the exploded dist)
+    ant.chmod(dir: "$explodedDistDir/bin", perm: "ugo+rx", includes: "**/*")
+}
+
+def removeAnyExistingOldGradleLibs() {
+    ant.delete { fileset(dir: explodedDistLibDir, includes: "$archivesBaseName-*.jar") }
+}
+
+// Left out of build.gradle (REL-0.8) for the bootstrap with gradle-0.6: everything after explodedDistBase,
+// i.e. docs (javadoc, groovydoc, userguide, distDocs, website), samples, zips (allZip, binZip, srcZip,
+// jdk14AllZip), retroTranslateLibs, integration tests (intTestImage, integTest), upload/release, install,
+// wrapper tasks. The distribution is built with: explodedDistBase
diff --git a/buildSrc/build.gradle.0.6 b/buildSrc/build.gradle.0.6
new file mode 100644
index 00000000000..8c4ebfb7454
--- /dev/null
+++ b/buildSrc/build.gradle.0.6
@@ -0,0 +1,31 @@
+// buildSrc/build.gradle of REL-0.8 in the DSL of Gradle 0.6 (the builder of this step), see settings.gradle.0.6
+import org.apache.ivy.plugins.resolver.*
+
+usePlugin('groovy')
+// code-quality (checkstyle, codenarc) not used for the bootstrap
+
+repositories {
+    mavenCentral()
+    add(new URLResolver()) {
+        name = 'sf_gradleRepo'
+        addArtifactPattern('https://gradle.sourceforge.net/gradleRepo/[organisation]/[module](/[branch])/[type]s/[artifact]-[revision](-[classifier])(.[ext])')
+    }
+}
+
+dependencies {
+    // com.svnkit:svnkit:1.1.6 is not on Maven Central: org.tmatesoft.svnkit 1.3.5
+    compile 'org.tmatesoft.svnkit:svnkit:1.3.5', 'org.tmatesoft.svnkit:svnkit-javahl:1.3.5'
+    testCompile "junit:junit:4.7"
+}
+// gradle-0.6 builder: no file dependencies, the classpaths are set on the compile tasks (as buildSrc of REL-0.6)
+compile.groovyClasspath = files(org.gradle.util.BootstrapUtil.groovyFiles)
+compileTests.groovyClasspath = files(org.gradle.util.BootstrapUtil.groovyFiles)
+compile.unmanagedClasspath(org.gradle.util.BootstrapUtil.gradleClasspath as File[])
+// the userguide helpers (org.gradle.build.docs) need a newer api: not compiled, docs are not built;
+// a forked groovyc (groovy 1.5) ignores the excludes: compile in-process (buildSrc compiles against the builder anyway)
+compile.groovyExclude('org/gradle/build/docs/**')
+compile.groovyOptions.fork = false
+
+
+// task ide (IDE classpath helper) left out
+
diff --git a/buildSrc/settings.gradle.0.6 b/buildSrc/settings.gradle.0.6
