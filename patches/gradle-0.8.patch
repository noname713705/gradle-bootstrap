@@ -0,0 +1,3 @@
+// Settings of the buildSrc build when building Gradle 0.8 with Gradle 0.6: buildSrc uses build.gradle.0.6
+// (selected by settings.gradle.0.6 in the root directory)
+rootProject.buildFileName = 'build.gradle.0.6'
diff --git a/settings.gradle.0.6 b/settings.gradle.0.6
new file mode 100644
index 00000000000..cc977c2ebe4
--- /dev/null
+++ b/settings.gradle.0.6
@@ -0,0 +1,20 @@
+// Settings for building Gradle 0.8 (REL-0.8 sources) with Gradle 0.6, the builder of this step.
+// Same projects as settings.gradle, but every build file is the <name>.0.6 one, in the DSL of Gradle 0.6.
+// usage: gradle-0.6 -c settings.gradle.0.6 -Dskip.<task>=true ... clean <dist task>
+include 'wrapper'
+include 'core'
+include 'ui'
+include 'openApi'
+
+rootProject.name = 'gradle'
+rootProject.buildFileName = 'build.gradle.0.6'
+rootProject.children.each {project ->
+    String fileBaseName = project.name.replaceAll("\\p{Upper}") { "-${it.toLowerCase()}" }
+    project.projectDir = new File(settingsDir, "subprojects/gradle-$fileBaseName")
+    project.buildFileName = "${fileBaseName}.gradle.0.6"
+    assert project.projectDir.isDirectory()
+    assert project.buildFile.isFile()
+}
+// the -b option and the build file names above do not apply to buildSrc: its own settings file selects
+// buildSrc/build.gradle.0.6 (a build file set here is lost when gradle 0.6 starts the buildSrc build)
+getBuildSrcStartParameter().setSettingsFile(new File(settingsDir, 'buildSrc/settings.gradle.0.6'))
