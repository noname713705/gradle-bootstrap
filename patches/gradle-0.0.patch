From 8d34563c73ffe2c9738d6bb8e8928fdc32fe1067 Mon Sep 17 00:00:00 2001
From: noname713705 <noname713705@gmail.com>
Date: Fri, 9 Oct 2026 22:56:46 +0200
Subject: [PATCH 2/4] ant build: write version.properties (needed by
 GradleVersion at startup)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 build.xml | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/build.xml b/build.xml
index fc3d7c4543a..4c77c10624e 100644
--- a/build.xml
+++ b/build.xml
@@ -88,6 +88,13 @@
         <copy todir="${buildClassesDirectory}">
             <fileset dir="src/main/resources"/>
         </copy>
+        <tstamp>
+            <format property="buildTime" pattern="EEEE, MMMM d, yyyy h:mm:ss a z" locale="en"/>
+        </tstamp>
+        <propertyfile file="${buildClassesDirectory}/version.properties">
+            <entry key="version" value="${version}"/>
+            <entry key="buildTime" value="${buildTime}"/>
+        </propertyfile>
     </target>
 
     <target name="compile" depends="resources" description="Compile">
-- 
