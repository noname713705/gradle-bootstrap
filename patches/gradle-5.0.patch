From f44b95022083dca7bd69a6d274b2cea0c11ae200 Mon Sep 17 00:00:00 2001
From: noname713705 <noname713705@gmail.com>
Date: Wed, 14 Oct 2026 09:38:13 +0200
Subject: [PATCH] Rebuild Gradle 5.0 from its original build files (download
 fixes only)

Built by a minimal bootstrap of 5.0 (scripts/GradleMinimalBootstrap50.java,
compiled without Gradle). Fixes, all marked "bootstrap:":
- Maven Central first (repo.gradle.org/gradle/libs does not mirror it anymore)
- bintray repositories removed (gone, requests hang until they time out)
- ktlint tasks skipped with the buildSrc checks (kolor 0.0.2 was on jcenter only)
- http-builder 0.7.2 (on no repository anymore) -> 0.7.1
- org.samba.jcifs:jcifs -> jcifs:jcifs (same version)
- kotlinx-metadata-jvm forced to 0.0.5 (0.0.4 was on bintray only)

Run: -Pjava9Home=<JDK 11> -Pgradlebuild.skipBuildSrcChecks=true clean install -Pgradle_installPath=build/distributions/rebuilt-minimal

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 build.gradle.kts                                | 17 +++++++++--------
 buildSrc/build.gradle.kts                       | 10 +++++-----
 .../performance/performance.gradle.kts          |  3 ++-
 gradle/dependencies.gradle                      |  3 ++-
 4 files changed, 18 insertions(+), 15 deletions(-)

diff --git a/build.gradle.kts b/build.gradle.kts
index 48b1217986e..fa0d1f94b44 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -149,18 +149,19 @@ allprojects {
     group = "org.gradle"
 
     repositories {
+        // bootstrap: repo.gradle.org/gradle/libs does not mirror Maven Central anymore: Maven Central first
+        mavenCentral()
         maven {
             name = "Gradle libs"
             url = uri("https://repo.gradle.org/gradle/libs")
         }
-        maven {
-            name = "kotlinx"
-            url = uri("https://kotlin.bintray.com/kotlinx/")
-        }
-        maven {
-            name = "kotlin-eap"
-            url = uri("https://dl.bintray.com/kotlin/kotlin-eap")
-        }
+        // bootstrap: bintray is gone (requests hang until they time out): kotlinx https://kotlin.bintray.com/kotlinx/ removed
+        // bootstrap: bintray is gone (requests hang until they time out): kotlin-eap https://dl.bintray.com/kotlin/kotlin-eap removed
+    }
+
+    // bootstrap: kotlinx-metadata-jvm 0.0.4 (Kotlin DSL 1.0.4) was on bintray only: the next version, 0.0.5
+    configurations.all {
+        resolutionStrategy.force("org.jetbrains.kotlinx:kotlinx-metadata-jvm:0.0.5")
     }
 
     // patchExternalModules lives in the root project - we need to activate normalization there, too.
diff --git a/buildSrc/build.gradle.kts b/buildSrc/build.gradle.kts
index 69b7f0c53e4..52026e9a5b7 100644
--- a/buildSrc/build.gradle.kts
+++ b/buildSrc/build.gradle.kts
@@ -79,6 +79,8 @@ subprojects {
 
 allprojects {
     repositories {
+        // bootstrap: repo.gradle.org/gradle/libs does not mirror Maven Central anymore: Maven Central first
+        mavenCentral()
         gradlePluginPortal()
         maven {
             name = "Gradle libs"
@@ -88,10 +90,7 @@ allprojects {
             name = "Gradle snapshot libs"
             url = uri("https://repo.gradle.org/gradle/libs-snapshots")
         }
-        maven {
-            name = "kotlin-eap"
-            url = uri("https://dl.bintray.com/kotlin/kotlin-eap")
-        }
+        // bootstrap: bintray is gone (requests hang until they time out): kotlin-eap https://dl.bintray.com/kotlin/kotlin-eap removed
     }
 }
 
@@ -104,7 +103,8 @@ dependencies {
 // Set gradlebuild.skipBuildSrcChecks Gradle property to "true" to disable all buildSrc verification tasks
 if (findProperty("gradlebuild.skipBuildSrcChecks") == "true") {
     allprojects {
-        tasks.matching { it.group == LifecycleBasePlugin.VERIFICATION_GROUP }.configureEach {
+        // bootstrap: also the ktlint tasks (their kolor 0.0.2 dependency was on bintray/jcenter only)
+        tasks.matching { it.group == LifecycleBasePlugin.VERIFICATION_GROUP || it.name.startsWith("ktlint") }.configureEach {
             enabled = false
         }
     }
diff --git a/buildSrc/subprojects/performance/performance.gradle.kts b/buildSrc/subprojects/performance/performance.gradle.kts
index 2b04c50442d..8885a17556a 100644
--- a/buildSrc/subprojects/performance/performance.gradle.kts
+++ b/buildSrc/subprojects/performance/performance.gradle.kts
@@ -3,7 +3,8 @@ apply(plugin = "org.gradle.kotlin.kotlin-dsl")
 dependencies {
     api(project(":integrationTesting"))
     implementation(project(":build"))
-    implementation("org.codehaus.groovy.modules.http-builder:http-builder:0.7.2") {
+    // bootstrap: http-builder 0.7.2 is on no repository anymore, no newer version exists: 0.7.1 (Maven Central)
+    implementation("org.codehaus.groovy.modules.http-builder:http-builder:0.7.1") {
         // Xerces on the runtime classpath is breaking some of our doc tasks
         exclude(group = "xerces")
     }
diff --git a/gradle/dependencies.gradle b/gradle/dependencies.gradle
index f54dfdd050a..8d2f0e15fbd 100755
--- a/gradle/dependencies.gradle
+++ b/gradle/dependencies.gradle
@@ -65,7 +65,8 @@ libraries.jackson_databind =    [coordinates: 'com.fasterxml.jackson.core:jackso
 libraries.jansi =               [coordinates: 'org.fusesource.jansi:jansi', version: '1.17.1']
 libraries.jatl =                [coordinates: 'com.googlecode.jatl:jatl', version: '0.2.3']
 libraries.jaxb =                [coordinates: 'com.sun.xml.bind:jaxb-impl', version: '2.3.1']
-libraries.jcifs =               [coordinates: 'org.samba.jcifs:jcifs', version: '1.3.17']
+// bootstrap: org.samba.jcifs:jcifs:1.3.17 is not on Maven Central anymore: jcifs:jcifs, same version
+libraries.jcifs =               [coordinates: 'jcifs:jcifs', version: '1.3.17']
 libraries.jcip =                [coordinates: 'net.jcip:jcip-annotations', version: '1.0']
 libraries.jgit =                [coordinates: 'org.eclipse.jgit:org.eclipse.jgit', version: '5.0.3.201809091024-r']
 libraries.joda =                [coordinates: 'joda-time:joda-time', version: '2.10']
-- 
