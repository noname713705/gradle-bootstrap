From d963be1416cfa4dcc12f83193ef66abe2a09e86d Mon Sep 17 00:00:00 2001
From: noname713705 <noname713705@gmail.com>
Date: Sat, 10 Oct 2026 00:08:21 +0200
Subject: [PATCH 2/2] groovyc: fork, so the builder's own classes don't shadow
 the sources being compiled

Forked groovyc (groovy 1.5.5) turns every nested javac option into a flag,
so only source and target are passed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../groovy/org/gradle/api/tasks/compile/AntGroovyc.groovy     | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/main/groovy/org/gradle/api/tasks/compile/AntGroovyc.groovy b/src/main/groovy/org/gradle/api/tasks/compile/AntGroovyc.groovy
index 9a7d469cb3e..5a5ad247722 100644
--- a/src/main/groovy/org/gradle/api/tasks/compile/AntGroovyc.groovy
+++ b/src/main/groovy/org/gradle/api/tasks/compile/AntGroovyc.groovy
@@ -29,11 +29,13 @@ class AntGroovyc extends AbstractAntCompile {
                                    String targetCompatibility, CompileOptions compileOptions) {
         antNode.groovyc(
                 includeAntRuntime: false,
+                fork: true,
                 srcdir: sourceDirs.join(':'),
                 destdir: targetDir,
                 classpathref: AbstractAntCompile.CLASSPATH_ID,
                 verbose: true) {
-            javac([source: sourceCompatibility, target: targetCompatibility] + compileOptions.optionMap())
+            // forked groovyc (groovy 1.5.5) turns every javac option into a flag, "false" breaks javac
+            javac([source: sourceCompatibility, target: targetCompatibility])
         }
     }
 
-- 
