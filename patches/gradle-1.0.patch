+apply plugin: 'groovy'
+// checkstyle, codenarc, idea, eclipse not used for the bootstrap
+
+repositories {
+    // gradle-0.9 builder: mavenRepo (maven { url } from 1.0)
+    mavenRepo(urls: 'https://repo.gradle.org/gradle/libs')
+    mavenCentral()
+}
+
+dependencies {
+    compile gradleApi()
+    compile 'com.google.guava:guava:11.0.1@jar'
+    compile 'commons-lang:commons-lang:2.6@jar'
+    groovy localGroovy()
+    // tests not run: spock left out
+    testCompile 'junit:junit:4.10@jar'
+
+    compile "org.pegdown:pegdown:1.1.0"
+    compile "org.jsoup:jsoup:1.6.3"
+}
+
+// configurations.all { resolutionStrategy {...} } (cache settings, not in gradle-0.9) left out
+
+apply from: '../gradle/compile.gradle.0.9'
+// codeQuality.gradle, classycle.gradle not used for the bootstrap
+
+// the documentation helpers (org.gradle.build.docs) need the 1.0 api: not compiled, docs are not built
+compileGroovy.exclude 'org/gradle/build/docs/**'
+// tests not compiled nor run (the buildSrc tests need spock)
+[compileTestJava, compileTestGroovy, processTestResources, test]*.enabled = false
