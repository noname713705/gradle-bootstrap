+++ b/buildSrc/settings.gradle
@@ -0,0 +1,7 @@
+// Bootstrap only (branch gradle-1.0): Gradle 1.0 is built by gradle-0.9 from build files in the 0.9 DSL
+// (see settings.gradle.0.9). gradle-0.9 builds buildSrc before any settings script and only from this
+// directory: this file points it to build.gradle.0.9. Any other Gradle (the bootstrapped 1.0 itself, later
+// versions) keeps the default build.gradle.
+if (gradle.gradleVersion.startsWith('0.9')) {
+    rootProject.buildFileName = 'build.gradle.0.9'
+}
