diff --git a/gradle/groovyProject.gradle.0.9 b/gradle/groovyProject.gradle.0.9
new file mode 100644
index 00000000000..9d54cf2aecb
--- /dev/null
+++ b/gradle/groovyProject.gradle.0.9
@@ -0,0 +1,65 @@
+// gradle/groovyProject.gradle of REL_1.0 in the DSL of Gradle 0.9 (the builder of this step), see settings.gradle.0.9
+import java.util.jar.Attributes
+
+apply plugin: 'groovy'
+// gradle-0.9: set here (plugins.withType(JavaPlugin) {...} in the root build.gradle of 1.0)
+sourceCompatibility = 1.5
+targetCompatibility = 1.5
+
+archivesBaseName = "gradle-${name.replaceAll("\\p{Upper}") { "-${it.toLowerCase()}" } }"
+
+if (!sourceSets.main.groovy.srcDirs.any{ it.exists() }) {
+    // Remove configurations.groovy from compile and runtime classpaths.
+    configurations {
+        compile.extendsFrom = []
+    }
+}
+
+dependencies {
+    testCompile libraries.junit, libraries.jmock, libraries.spock
+}
+
+apply from: "$rootDir/gradle/compile.gradle.0.9"
+
+// test { maxParallelForks ... } and options.useAnt = false (in-process compilers, 1.0) left out: tests not run,
+// gradle-0.9 compiles with ant
+
+tasks.withType(Jar).each { jar ->
+    jar.manifest.mainAttributes([
+            (Attributes.Name.IMPLEMENTATION_TITLE.toString()): 'Gradle',
+            (Attributes.Name.IMPLEMENTATION_VERSION.toString()): version.toString(),
+    ])
+}
+
+// gradle-0.9: no sourceSets.main.output.dir (1.0); the classpath manifest is written into the classes dir,
+// before the jar. test fixtures and integration tests (testFixtures.gradle, integTest.gradle) left out
+generatedResourcesDir = sourceSets.main.classesDir
+
+task classpathManifest(type: ClasspathManifest)
+classpathManifest.dependsOn compileGroovy
+jar.dependsOn classpathManifest
+
+class ClasspathManifest extends DefaultTask {
+    @OutputFile
+    File getManifestFile() {
+        return new File(project.sourceSets.main.classesDir, "${project.archivesBaseName}-classpath.properties")
+    }
+
+    @Input
+    Properties getProperties() {
+        def properties = new Properties()
+        // the files of the external dependencies (and theirs), as runtime.fileCollection { it instanceof ExternalDependency } of 1.0
+        properties.runtime = project.configurations.runtime.copyRecursive { it instanceof ExternalDependency }.files.collect {it.name}.join(',')
+        properties.projects = project.configurations.runtime.allDependencies.findAll { it instanceof ProjectDependency }.collect {it.dependencyProject.archivesBaseName}.join(',')
+        return properties
+    }
+
+    @TaskAction
+    def generate() {
+        manifestFile.parentFile.mkdirs()
+        manifestFile.withOutputStream { properties.save(it, 'module definition') }
+    }
+}
+
+// bootstrap: tests are not compiled nor run (see README)
+[compileTestJava, compileTestGroovy, processTestResources, test]*.enabled = false
