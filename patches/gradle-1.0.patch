+// apply from: "$rootDir/gradle/classycle.gradle.0.9"   // classycle (code quality) not used for the bootstrap
+
+dependencies {
+    groovy libraries.groovy
+    compile project(":cli")
+    testCompile libraries.ant
+}
+
+// gradle-0.9: no sourceSets.main.output (1.0), the classes dirs (which also hold the classpath manifests here)
+def executableJarProjects = [project] + configurations.runtime.allDependencies.findAll { it instanceof ProjectDependency }.collect { it.dependencyProject }
+task executableJar(type: Jar, dependsOn: executableJarProjects.collect { [it.compileJava, it.classpathManifest] }.flatten()) {
+    archiveName = 'gradle-wrapper.jar'
+    executableJarProjects.each { p -> from p.sourceSets.main.classesDir }
+}
+
+useTestFixtures()
+
