@@ -0,0 +1,18 @@
+// gradle/providedConfiguration.gradle of REL_1.0 in the DSL of Gradle 0.9 (the builder of this step), see settings.gradle.0.9
+/**
+ * Adds a configuration named 'provided'. 'Provided' dependencies
+ * are incoming compile dependencies that aren't outgoing
+ * dependencies. In other words, they have no effect on transitive
+ * dependency management.
+ */
+
+configurations {
+    provided.extendsFrom(compile)
+    testCompile.extendsFrom(provided)
+}
+
+sourceSets.main {
+    compileClasspath = configurations.provided
+}
+
+// plugins.withType(IdeaPlugin) {...}: idea not used for the bootstrap
