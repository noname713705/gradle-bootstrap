new file mode 100644
index 00000000000..863abf10af9
--- /dev/null
+++ b/gradle/compile.gradle.0.9
@@ -0,0 +1,9 @@
+// gradle/compile.gradle of REL_1.0 in the DSL of Gradle 0.9 (the builder of this step), see settings.gradle.0.9
+// gradle-0.9: no withType(type) {closure}, the (already created) compile tasks are configured with each
+tasks.withType(Compile).each { task ->
+    task.options.encoding = 'utf-8'
+}
+tasks.withType(GroovyCompile).each { task ->
+    task.options.encoding = 'utf-8'
+    task.groovyOptions.encoding = 'utf-8'
+}
