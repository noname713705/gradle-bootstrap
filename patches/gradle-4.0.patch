diff --git a/buildSrc/src/bootstrap-3.0/groovy/org/gradle/build/bootstrap/JavaLibraryConfigurations.groovy b/buildSrc/src/bootstrap-3.0/groovy/org/gradle/build/bootstrap/JavaLibraryConfigurations.groovy
