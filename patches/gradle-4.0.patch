@@ -0,0 +1,44 @@
+/*
+ * Bootstrap only (branch gradle-4.0, compiled by buildSrc/build.gradle.3.0): Gradle 4.0's build uses the java-library
+ * plugin (Gradle 3.4) and the configurations of the java plugin from 3.4 on. gradle-3.0 has compileOnly and
+ * compileClasspath; this plugin adds, for every source set, the configurations that are missing:
+ *   <sourceSet>Implementation, <sourceSet>RuntimeOnly, <sourceSet>RuntimeClasspath, and api for main.
+ * Also the 4.0 properties SourceSetOutput.classesDirs (the classes dir of 3.0) and Test.testClassesDirs (an extra
+ * property only: the test tasks are not run for the bootstrap).
+ * They map to the 3.0 ones: compile extends api and implementation, runtime extends runtimeOnly, runtimeClasspath
+ * extends runtime. No api/implementation separation (everything is on the compile classpath of the consumers):
+ * enough to build, the compiled classes are the same.
+ * Applied to every java project by build.gradle.3.0; the plugin id java-library (JavaLibraryBootstrapPlugin)
+ * applies the java plugin and this one. Not used by the original build.
+ */
+package org.gradle.build.bootstrap
+
+import org.gradle.api.Plugin
+import org.gradle.api.Project
+import org.gradle.api.plugins.JavaPlugin
+import org.gradle.api.tasks.SourceSet
+import org.gradle.api.tasks.testing.Test
+
+class JavaLibraryConfigurations implements Plugin<Project> {
+    void apply(Project project) {
+        project.plugins.apply(JavaPlugin)
+        def configurations = project.configurations
+        project.tasks.withType(Test) { it.ext.testClassesDirs = null }
+        project.sourceSets.all { SourceSet sourceSet ->
+            def prefix = sourceSet.name == 'main' ? '' : sourceSet.name
+            def name = { String base -> prefix ? prefix + base.capitalize() : base }
+            def compile = configurations.getByName(sourceSet.compileConfigurationName)
+            def runtime = configurations.getByName(sourceSet.runtimeConfigurationName)
+            def implementation = configurations.maybeCreate(name('implementation'))
+            def runtimeOnly = configurations.maybeCreate(name('runtimeOnly'))
+            def runtimeClasspath = configurations.maybeCreate(name('runtimeClasspath'))
+            compile.extendsFrom(implementation)
+            runtime.extendsFrom(runtimeOnly)
+            runtimeClasspath.extendsFrom(runtime)
+            sourceSet.output.ext.classesDirs = project.files({ sourceSet.output.classesDir })
+            if (sourceSet.name == 'main') {
+                compile.extendsFrom(configurations.maybeCreate('api'))
+            }
+        }
+    }
+}
