+    classpath = files([])
+    doFirst {
+        classpath = files(
+            rootProject.configurations.externalModules,
+            [':core', ':dependencyManagement', ':pluginUse', ":toolingApi"].collect() {
+                project(it).configurations.runtime
+            }, project(':').configurations.gradlePlugins)
