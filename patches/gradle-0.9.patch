+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+include 'core'
+include 'wrapper'
+include 'launcher'
+include 'plugins'
+include 'scala'
+include 'eclipse'
+include 'idea'
+include 'osgi'
+include 'maven'
+include 'announce'
+include 'jetty'
+include 'codeQuality'
+include 'antlr'
+include 'ui'
+include 'openApi'
+// include 'docs': documentation only, not built for the bootstrap
+
+rootProject.name = 'gradle'
+rootProject.buildFileName = 'build.gradle.0.8'
+rootProject.children.each {project ->
+    String fileBaseName = project.name.replaceAll("\\p{Upper}") { "-${it.toLowerCase()}" }
+    project.projectDir = new File(settingsDir, "subprojects/gradle-$fileBaseName")
+    project.buildFileName = "${fileBaseName}.gradle.0.8"
+    assert project.projectDir.isDirectory()
+    assert project.buildFile.isFile()
+}
+
+// buildSrc: gradle-0.8 builds it before this file is read, buildSrc/settings.gradle selects buildSrc/build.gradle.0.8
