+ * limitations under the License.
+ */
+// apply plugin: 'groovy': the groovy plugin is applied by the root project (usePlugin, gradle-0.8)
+
+dependencies {
+    groovy libraries.groovy_depends
+    compile project(':core')
+
+    compile libraries.commons_io, libraries.ant, libraries.ant_nodeps
+
+    // testCompile project(path: ':core', configuration: 'testFixtures')   // tests not run
+    // testRuntime project(path: ':core', configuration: 'testFixturesRuntime')   // tests not run
+}
+
+// gradle-0.8 builder: Jar tasks have no copy spec (exclude/from/include). gradle-wrapper.jar (the wrapper classes,
+// copied into projects by the wrapper task) is built with ant after the compilation, into the classes dir as in 0.9.
+// The wrapper classes stay in the jar of this project too (not excluded as in 0.9).
+compileGroovy.doLast {
+    ant.jar(destfile: new File(sourceSets.main.classesDir, 'gradle-wrapper.jar')) {
+        fileset(dir: sourceSets.main.classesDir, includes: 'org/gradle/wrapper/**')
+        manifest {
+            attribute(name: 'Main-Class', value: 'org.gradle.wrapper.GradleWrapperMain')
+        }
+    }
+}
