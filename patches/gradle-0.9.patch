+dependencies {
+    // gradle-0.8 builder: no gradleApi()/localGroovy(), the classpaths of the builder (as buildSrc of REL-0.8)
+    compile files(org.gradle.util.BootstrapUtil.gradleClasspath)
+    groovy files(org.gradle.util.BootstrapUtil.groovyFiles)
+    compile 'com.google.collections:google-collections:1.0@jar'
+    // tests not run: spock (only on the artifactory repository) left out
+    testCompile 'junit:junit:4.8.1@jar'
+}
+
+// the documentation helpers (org.gradle.build.docs) need a newer api: not compiled, docs are not built;
+// a forked groovyc ignores the excludes: compile in-process (buildSrc compiles against the builder anyway)
+compileGroovy.exclude 'org/gradle/build/docs/**'
+// Install (task type of install/installAll) extends Sync, not in gradle-0.8: not compiled, not used for the bootstrap
+compileGroovy.exclude 'org/gradle/build/Install.groovy'
+compileGroovy.groovyOptions.fork = false
diff --git a/buildSrc/settings.gradle b/buildSrc/settings.gradle
new file mode 100644
index 00000000000..bfeb270bd58
--- /dev/null
+++ b/buildSrc/settings.gradle
@@ -0,0 +1,13 @@
+// Bootstrap only (branch gradle-0.9): Gradle 0.9 is built by gradle-0.8 from build files in the 0.8 DSL
+// (see settings.gradle.0.8). gradle-0.8 builds buildSrc before any settings script and only from this
+// directory: this file points it to build.gradle.0.8. Any other Gradle (the bootstrapped 0.9 itself, later
+// versions) keeps the default build.gradle.
+String runningVersion
+try {
+    runningVersion = gradle.gradleVersion                          // 0.9 and later
+} catch (MissingPropertyException e) {
+    runningVersion = new org.gradle.util.GradleVersion().version   // 0.8: no gradle object in settings
+}
+if (runningVersion.startsWith('0.8')) {
+    rootProject.buildFileName = 'build.gradle.0.8'
+}
