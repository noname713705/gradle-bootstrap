+
+task pluginsManifest(type: PluginsManifest)
+sourceSets.main.output.dir generatedResourcesDir, builtBy: pluginsManifest
+
+class PluginsManifest extends DefaultTask {
+    @OutputFile
+    File getPropertiesFile() {
+        return new File(project.generatedResourcesDir, "gradle-plugins.properties")
+    }
+
+    @Input
+    Properties getPluginProperties() {
+        def properties = new Properties()
+        properties.plugins = project.pluginProjects.collect { it.archivesBaseName }.join(',')
+        return properties
+    }
+
+    @TaskAction
+    def generate() {
+        propertiesFile.withOutputStream { pluginProperties.save(it, 'plugin definitions') }
+    }
+}
+
+// default-imports.txt: in 2.0 generated by the docs project (defaultImports, from the DSL meta-data of groovydocAll),
+// not built for the bootstrap. Same result from the sources: the packages of the public API classes
+// (javadocAll includes/excludes, public projects), with the excludes/extras of the docs defaultImports task.
+task defaultImports {
+    ext.destFile = new File(generatedResourcesDir, "default-imports.txt")
+    def srcDirs = rootProject.file('subprojects').listFiles().findAll {
+        !it.name.startsWith('internal') && !(it.name in ['integ-test', 'distributions', 'docs', 'performance'])
+    }.collectMany { [new File(it, 'src/main/java'), new File(it, 'src/main/groovy')] }.findAll { it.directory }
+    inputs.files srcDirs
+    outputs.file destFile
+    doLast {
+        def includes = ['org/gradle/api/**', 'org/gradle/*', 'org/gradle/external/javadoc/**', 'org/gradle/language/**',
+            'org/gradle/ide/**', 'org/gradle/nativebinaries/**', 'org/gradle/process/**', 'org/gradle/plugins/**',
+            'org/gradle/runtime/**', 'org/gradle/testfixtures/**', 'org/gradle/tooling/**', 'org/gradle/testing/jacoco/**',
+            'org/gradle/buildinit/**']
+        def excludedPrefixes = ['org.gradle.tooling.', 'org.gradle.testfixtures.']
+        def excludedPackages = ['org.gradle.tooling', 'org.gradle.testfixtures', 'org.gradle.plugins.ide.eclipse.model',
+            'org.gradle.plugins.ide.idea.model', 'org.gradle.api.tasks.testing.logging', 'org.gradle.plugins.binaries.model',
+            'org.gradle.ide.cdt.model']
+        def packages = new TreeSet(['org.gradle.util'])
+        srcDirs.each { dir ->
+            project.fileTree(dir: dir, includes: includes, excludes: ['**/internal/**', '**/package-info.java']).visit { f ->
+                if (!f.directory && (f.name.endsWith('.java') || f.name.endsWith('.groovy'))) {
+                    def pkg = f.relativePath.parent.segments.join('.')
+                    if (!(pkg in excludedPackages) && !excludedPrefixes.any { pkg.startsWith(it) }) {
+                        packages << pkg
+                    }
+                }
+            }
+        }
+        destFile.parentFile.mkdirs()
+        destFile.text = packages.collect { "import ${it}.*\n" }.join('')
+    }
+}
+sourceSets.main.output.dir generatedResourcesDir, builtBy: defaultImports
